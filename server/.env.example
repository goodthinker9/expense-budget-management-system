# ─────────────────────────────────────────────────────────────────────────────
# FinTrackET Server — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Port the Express server listens on
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — Session pooler URL (port 5432)
# Copy from: Supabase Dashboard → Your project → Connect
#            → Session pooler → URI
# IMPORTANT: use port 5432 (session mode), NOT 6543 (transaction mode).
#            Transaction mode breaks RETURNING clauses used by this app.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs.
# In production: use a random string of at least 32 characters.
JWT_SECRET=replace_this_with_a_long_random_secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed browser origin(s) for CORS.
# Separate multiple origins with commas, no spaces around the comma:
#   CLIENT_ORIGIN=https://app.example.com,https://www.example.com
CLIENT_ORIGIN=http://localhost:5173

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" in deployed environments.
# Affects: JWT_SECRET length check, DB_SSL_CA warning, seed guard.
NODE_ENV=development

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Set to "true" to disable all rate limiters during local development/testing.
# Never set this in production.
DISABLE_RATE_LIMIT=false

# ── Database SSL certificate (optional but recommended in production) ─────────
# PEM text of Supabase's root CA certificate.
# Download from: Supabase dashboard → Database → Settings → SSL configuration
#                → "Download certificate" → copy the contents here.
# Replace literal newlines with \n so the value fits on one line, e.g.:
#   DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
# When set, the server verifies the DB certificate (rejectUnauthorized: true).
# When absent, certificate verification is skipped (rejectUnauthorized: false)
# and a warning is printed in production.
# DB_SSL_CA=

# ── Seed script ───────────────────────────────────────────────────────────────
# The seed script refuses to run when NODE_ENV=production unless this is "true".
# Never set this on a live database.
# ALLOW_SEED=true
