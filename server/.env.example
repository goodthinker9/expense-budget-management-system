# Port the Express server listens on
PORT=4000

# Supabase PostgreSQL — Session pooler URL (port 5432)
# Copy from: Supabase Dashboard → Your project → Connect
#            → Session pooler → URI
# IMPORTANT: use port 5432 (session mode), NOT 6543 (transaction mode).
#            Transaction mode breaks RETURNING clauses used by this app.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Origin of the React dev/prod server — restricts CORS
CLIENT_ORIGIN=http://localhost:5173
